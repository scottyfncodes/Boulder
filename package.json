{
  "name": "bruh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:beta": "esbuild scripts/gen-beta.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen-beta.mjs --log-level=error && node node_modules/.cache/gen-beta.mjs",
    "check:overlay": "node scripts/check-overlay.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "show:routes": "esbuild scripts/show-routes.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/show-routes.mjs --log-level=error && node node_modules/.cache/show-routes.mjs",
    "playtest": "esbuild scripts/playtest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/playtest.mjs --log-level=error && node node_modules/.cache/playtest.mjs",
    "fit:grades": "esbuild scripts/grade-features.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/grade-features.mjs --log-level=error && node node_modules/.cache/grade-features.mjs && python3 scripts/fit-grades.py",
    "find:highballs": "esbuild scripts/find-highballs.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/find-highballs.mjs --log-level=error && node node_modules/.cache/find-highballs.mjs",
    "gen:grades": "esbuild scripts/gen-grades.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen-grades.mjs --log-level=error && node node_modules/.cache/gen-grades.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
